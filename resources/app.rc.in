IDI_ICON1 ICON "@CMAKE_SOURCE_DIR@/resources/app.ico"

1 VERSIONINFO
 FILEVERSION @PROJECT_VERSION_MAJOR@,@PROJECT_VERSION_MINOR@,@PROJECT_VERSION_PATCH@,0
 PRODUCTVERSION @PROJECT_VERSION_MAJOR@,@PROJECT_VERSION_MINOR@,@PROJECT_VERSION_PATCH@,0
 FILEFLAGSMASK 0x3fL
 FILEFLAGS 0x0L
 FILEOS 0x40004L
 FILETYPE 0x1L
 FILESUBTYPE 0x0L
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "CompanyName",      "Andrii Kondratiev"
            VALUE "FileDescription",  "Stepan - Coordinate System Converter"
            VALUE "FileVersion",      "@PROJECT_VERSION@.0"
            VALUE "InternalName",     "Stepan"
            VALUE "LegalCopyright",   "Copyright (c) 2026 Andrii Kondratiev"
            VALUE "OriginalFilename", "Stepan.exe"
            VALUE "ProductName",      "Stepan"
            VALUE "ProductVersion",   "@APP_VERSION_FULL@ (@GIT_COMMIT_HASH@)"
            VALUE "Comments",         "https://github.com/keedhost/stepan"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
